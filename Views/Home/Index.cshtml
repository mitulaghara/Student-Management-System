<div class="pagetitle">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item active"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section dashboard">
    <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-8">
            <div class="row">

                <!-- Students Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Students <span>| Total</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary">
                                    <i class="fa-solid fa-user-graduate fs-4"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.StudentCount</h6>
                                    <span class="text-success small pt-1 fw-bold">Active</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Students Card -->

                <!-- Staff Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card revenue-card">
                        <div class="card-body">
                            <h5 class="card-title">Staff / Faculty <span>| Total</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-success-subtle text-success">
                                    <i class="fa-solid fa-user-tie fs-4"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.StaffCount</h6>
                                    <span class="text-success small pt-1 fw-bold">Active</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Staff Card -->

                <!-- Course Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card customers-card">
                        <div class="card-body">
                            <h5 class="card-title">Courses <span>| Offered</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-warning-subtle text-warning">
                                    <i class="fa-solid fa-graduation-cap fs-4"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.CourseCount</h6>
                                    <span class="text-muted small pt-2 ps-1">Programs</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Course Card -->

                <!-- Department Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Departments <span>| Total</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-info-subtle text-info">
                                    <i class="fa-solid fa-building fs-4"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.DepartmentCount</h6>
                                    <span class="text-muted small pt-2 ps-1">Branches</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Department Card -->

                <!-- Classroom Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card revenue-card">
                        <div class="card-body">
                            <h5 class="card-title">Classrooms <span>| Available</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-secondary-subtle text-secondary">
                                    <i class="fa-solid fa-school fs-4"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.ClassroomCount</h6>
                                    <span class="text-success small pt-1 fw-bold">Live</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Classroom Card -->

                <!-- Advising Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card customers-card">
                        <div class="card-body">
                            <h5 class="card-title">Enrollments <span>| Active</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-danger-subtle text-danger">
                                    <i class="fa-solid fa-users fs-4"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.EnrollmentCount</h6>
                                    <span class="text-success small pt-1 fw-bold">Mentorships</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Advising Card -->

            </div>
        </div><!-- End Left side columns -->

        <!-- Right side columns -->
        <div class="col-lg-4">
            <!-- Google Chart Card -->
            <div class="card">
                <div class="card-body pb-0">
                    <h5 class="card-title">Enrollment Statistics <span>| Department-wise</span></h5>
                    <div id="enrollmentChart" style="min-height: 290px;" class="echart"></div>
                </div>
            </div><!-- End Google Chart Card -->
        </div><!-- End Right side columns -->

    </div>
</section>

<!-- Google Charts JS Loading -->
<script src="https://www.gstatic.com/charts/loader.js"></script>
<script>
    google.charts.load('current', {packages:['corechart']});
    google.charts.setOnLoadCallback(drawChart);

    function drawChart() {
        const data = google.visualization.arrayToDataTable([
            ['Department', 'Students'],
            ['Computer Science', @ViewBag.StudentCount > 0 ? @ViewBag.StudentCount : 3],
            ['Information Technology', 2],
            ['Mechanical Engineering', 1],
            ['Civil Engineering', 0]
        ]);

        const options = {
            title: 'Students enrolled per Department',
            pieHole: 0.4,
            colors: ['#4154f1', '#2eca6a', '#ff771d', '#17a2b8']
        };

        const chart = new google.visualization.PieChart(document.getElementById('enrollmentChart'));
        chart.draw(data, options);
    }
</script>