@model StudentManagementSystem.Models.Student

<div class="pagetitle">
    <h1>Add / Edit Student</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Student" asp-action="StudentList"><i class="fa-solid fa-user-graduate"></i> Students</a></li>
            <li class="breadcrumb-item active"><i class="bi bi-pencil-square"></i> Student Profile</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<div class="card">
    <div class="card-body p-5">
        <form asp-controller="Student" asp-action="Save" method="post" class="row g-3">
            <input type="hidden" asp-for="StudentID" />

            <div class="col-md-12 fs-3 fw-bold mb-3 border-bottom pb-2">
                <span>@(Model.StudentID == 0 ? "Register New Student" : "Edit Student Profile")</span>
            </div>

            <!-- Student Name -->
            <div class="col-md-6">
                <label asp-for="StudentName" class="form-label fw-bold">Student Name</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person-fill text-primary"></i></span>
                    <input type="text" class="form-control" placeholder="Enter Full Name" asp-for="StudentName">
                </div>
                <span asp-validation-for="StudentName" class="text-danger fw-bold fs-7"></span>
            </div>

            <!-- Roll No -->
            <div class="col-md-6">
                <label asp-for="RollNo" class="form-label fw-bold">Roll / Enrollment No</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-card-text text-primary"></i></span>
                    <input type="text" class="form-control" placeholder="e.g. CS2026-001" asp-for="RollNo">
                </div>
                <span asp-validation-for="RollNo" class="text-danger fw-bold fs-7"></span>
            </div>

            <!-- Email Address -->
            <div class="col-md-6">
                <label asp-for="EmailAddress" class="form-label fw-bold">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope-fill text-primary"></i></span>
                    <input type="email" class="form-control" placeholder="Enter Email" asp-for="EmailAddress">
                </div>
                <span asp-validation-for="EmailAddress" class="text-danger fw-bold fs-7"></span>
            </div>

            <!-- Mobile No -->
            <div class="col-md-6">
                <label asp-for="MobileNo" class="form-label fw-bold">Mobile Number</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone-fill text-primary"></i></span>
                    <input type="text" class="form-control" placeholder="Enter 10-digit Mobile No" asp-for="MobileNo">
                </div>
                <span asp-validation-for="MobileNo" class="text-danger fw-bold fs-7"></span>
            </div>

            <!-- Birth Date -->
            <div class="col-md-6">
                <label asp-for="BirthDate" class="form-label fw-bold">Date of Birth</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar-event-fill text-primary"></i></span>
                    <input type="date" class="form-control" asp-for="BirthDate">
                </div>
                <span asp-validation-for="BirthDate" class="text-danger fw-bold fs-7"></span>
            </div>

            <!-- Department Dropdown -->
            <div class="col-md-6">
                <label asp-for="DepartmentName" class="form-label fw-bold">Department</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-building text-primary"></i></span>
                    <select class="form-select" asp-for="DepartmentName">
                        <option value="">-- Select Department --</option>
                        @foreach (var dept in ViewBag.Departments)
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>
                </div>
                <span asp-validation-for="DepartmentName" class="text-danger fw-bold fs-7"></span>
            </div>

            <!-- Course Dropdown -->
            <div class="col-md-6">
                <label asp-for="CourseName" class="form-label fw-bold">Course Program</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-graduation-cap text-primary"></i></span>
                    <select class="form-select" asp-for="CourseName">
                        <option value="">-- Select Course --</option>
                        @foreach (var crs in ViewBag.Courses)
                        {
                            <option value="@crs">@crs</option>
                        }
                    </select>
                </div>
                <span asp-validation-for="CourseName" class="text-danger fw-bold fs-7"></span>
            </div>

            <!-- Classroom Dropdown -->
            <div class="col-md-6">
                <label asp-for="ClassroomName" class="form-label fw-bold">Assigned Classroom</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-school text-primary"></i></span>
                    <select class="form-select" asp-for="ClassroomName">
                        <option value="">-- Select Classroom --</option>
                        @foreach (var cls in ViewBag.Classrooms)
                        {
                            <option value="@cls">@cls</option>
                        }
                    </select>
                </div>
                <span asp-validation-for="ClassroomName" class="text-danger fw-bold fs-7"></span>
            </div>

            <!-- Active Status -->
            <div class="col-md-12 mt-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" asp-for="IsActive">
                    <label class="form-check-label fw-bold" for="isActiveSwitch">Is Active Student?</label>
                </div>
            </div>

            <div class="col-12 mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2-circle me-1"></i> Save Student Record</button>
                <a asp-controller="Student" asp-action="StudentList" class="btn btn-secondary px-4"><i class="bi bi-x-octagon-fill me-1"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
