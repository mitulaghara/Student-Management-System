@model List<Student>

<div class="pagetitle">
    <h1>Students Directory</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-user-graduate"></i> Student List</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (ViewBag.IsMock == true)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <strong>Running on Mock Data!</strong> Could not connect to MongoDB. Please check your connection string in appsettings.json.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-x-circle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="m-2">
    <div class="bg-primary-subtle rounded row pt-2 pb-2 align-items-center">
        <div class="col-6"></div>
        <div class="col-6 text-end pe-4 d-flex justify-content-end gap-2">
            <a asp-controller="Student" asp-action="ExportToCsv" class="btn btn-success"><i class="bi bi-file-earmark-excel-fill me-1"></i> Export to Excel / CSV</a>
            <a asp-controller="Student" asp-action="StudentAddEdit" class="btn btn-primary"><i class="bi bi-plus-square-fill me-1"></i> Register Student</a>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Enrolled Students</h5>

                    <!-- Table with stripped rows -->
                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th class="text-center">Roll No</th>
                                <th>Student Name</th>
                                <th>Department</th>
                                <th>Course</th>
                                <th>Classroom</th>
                                <th>Contact</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center"><span class="badge bg-secondary">@item.RollNo</span></td>
                                    <td><strong>@item.StudentName</strong></td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.CourseName</td>
                                    <td>@item.ClassroomName</td>
                                    <td>
                                        <div><i class="bi bi-telephone text-muted me-1"></i>@item.MobileNo</div>
                                        <div><i class="bi bi-envelope text-muted me-1"></i><small>@item.EmailAddress</small></div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger" title="Dropped: @item.DropReason (@item.DropDate?.ToString("yyyy-MM-dd"))">Dropped</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Student" asp-action="StudentAddEdit" asp-route-id="@item.StudentID" class="text-warning me-3" title="Edit Student Profile">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a asp-controller="Student" asp-action="Delete" asp-route-id="@item.StudentID" class="text-danger" title="Delete Student Record"
                                           onclick="return confirm('Are you sure you want to delete this student record?')">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <!-- End Table with stripped rows -->

                </div>
            </div>

        </div>
    </div>
</section>
