@model List<Course>

<div class="pagetitle">
    <h1>Courses</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-graduation-cap"></i> Course List</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (ViewBag.IsMock == true)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <strong>Running on Mock Data!</strong> Could not connect to your SQL Server database. Please set it up using the SQL script <code>StudentManagementSystem.sql</code>.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="m-2">
    <div class="bg-primary-subtle rounded row pt-2 pb-2 align-items-center">
        <div class="col-7"></div>
        <div class="col-5 text-end pe-4">
            <a asp-controller="Course" asp-action="CourseAddEdit" class="btn btn-primary"><i class="bi bi-plus-square-fill"></i> Add Course</a>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Offered Academic Courses</h5>

                    <!-- Table with stripped rows -->
                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th class="text-center">Course ID</th>
                                <th>Course Name</th>
                                <th>Remarks / Description</th>
                                <th class="text-center">Created</th>
                                <th class="text-center">Modified</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item.CourseID</td>
                                    <td><strong>@item.CourseName</strong></td>
                                    <td>@(string.IsNullOrEmpty(item.Remarks) ? "--" : item.Remarks)</td>
                                    <td class="text-center">@item.Created.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">@item.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <a asp-controller="Course" asp-action="CourseAddEdit" asp-route-id="@item.CourseID" class="text-warning me-3" title="Edit Course">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a asp-controller="Course" asp-action="Delete" asp-route-id="@item.CourseID" class="text-danger" title="Delete Course"
                                           onclick="return confirm('Are you sure you want to delete this course?')">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <!-- End Table with stripped rows -->

                </div>
            </div>

        </div>
    </div>
</section>
