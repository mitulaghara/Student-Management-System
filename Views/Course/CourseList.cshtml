@model List<Course>

<div class="pagetitle">
    <h1>Courses</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-graduation-cap"></i> Course List</li>
        </ol>
    </nav>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="action-toolbar mb-3">
    <span class="fw-semibold text-muted fs-6">Academic Courses</span>
    <div class="action-btns">
        <a asp-controller="Course" asp-action="CourseAddEdit" class="btn btn-primary"><i class="bi bi-plus-square-fill me-1"></i> Add Course</a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Offered Academic Courses</h5>

                    <div class="table-responsive">
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="min-width: 90px;">Course ID</th>
                                    <th style="min-width: 160px;">Course Name</th>
                                    <th style="min-width: 180px;">Remarks / Description</th>
                                    <th class="text-center" style="min-width: 140px;">Created</th>
                                    <th class="text-center" style="min-width: 140px;">Modified</th>
                                    <th class="text-center" style="min-width: 90px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@item.CourseID</td>
                                        <td><strong>@item.CourseName</strong></td>
                                        <td>@(string.IsNullOrEmpty(item.Remarks) ? "--" : item.Remarks)</td>
                                        <td class="text-center" style="white-space: nowrap;">@item.Created.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-center" style="white-space: nowrap;">@item.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-center" style="white-space: nowrap;">
                                            <a asp-controller="Course" asp-action="CourseAddEdit" asp-route-id="@item.CourseID" class="text-warning me-2" title="Edit Course">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </a>
                                            <a asp-controller="Course" asp-action="Delete" asp-route-id="@item.CourseID" class="text-danger" title="Delete Course"
                                               onclick="return confirm('Are you sure you want to delete this course?')">
                                                <i class="bi bi-trash fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
