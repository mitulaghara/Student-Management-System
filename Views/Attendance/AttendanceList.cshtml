@model List<StudentManagementSystem.Models.Attendance>

<div class="pagetitle">
    <h1>Attendance Management</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-clipboard-check"></i> Attendance Records</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.IsMock == true)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <strong>Running on Mock Data!</strong> Could not connect to MongoDB. Check your connection string in appsettings.json.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="m-2">
    <div class="bg-primary-subtle rounded row pt-2 pb-2 align-items-center">
        <div class="col-6"></div>
        <div class="col-6 text-end pe-4 d-flex justify-content-end gap-2">
            <a asp-controller="Attendance" asp-action="ExportToCsv" class="btn btn-success"><i class="bi bi-file-earmark-excel-fill me-1"></i> Export to Excel / CSV</a>
            <a asp-controller="Attendance" asp-action="AttendanceAddEdit" class="btn btn-primary"><i class="bi bi-plus-square-fill me-1"></i> Mark Attendance</a>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Student Attendance Records</h5>

                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>Student Name</th>
                                <th>Subject</th>
                                <th class="text-center">Date</th>
                                <th class="text-center">Status</th>
                                <th>Remarks</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item.AttendanceID</td>
                                    <td><strong>@item.StudentName</strong></td>
                                    <td>@(string.IsNullOrEmpty(item.Subject) ? "--" : item.Subject)</td>
                                    <td class="text-center">@item.AttendanceDate.ToString("dd-MMM-yyyy")</td>
                                    <td class="text-center">
                                        @if (item.Status == "Present")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Present</span>
                                        }
                                        else if (item.Status == "Absent")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Absent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Late</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(item.Remarks) ? "--" : item.Remarks)</td>
                                    <td class="text-center">
                                        <a asp-controller="Attendance" asp-action="AttendanceAddEdit" asp-route-id="@item.AttendanceID"
                                           class="text-warning me-3" title="Edit Record">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a asp-controller="Attendance" asp-action="Delete" asp-route-id="@item.AttendanceID"
                                           class="text-danger" title="Delete Record"
                                           onclick="return confirm('Are you sure you want to delete this attendance record?')">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</section>
