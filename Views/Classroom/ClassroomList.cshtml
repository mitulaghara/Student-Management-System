@model List<Classroom>

<div class="pagetitle">
    <h1>Classrooms</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-school"></i> Classroom List</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="m-2">
    <div class="bg-primary-subtle rounded row pt-2 pb-2 align-items-center">
        <div class="col-7"></div>
        <div class="col-5 text-end pe-4">
            <a asp-controller="Classroom" asp-action="ClassroomAddEdit" class="btn btn-primary"><i class="bi bi-plus-square-fill"></i> Add Classroom</a>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Classrooms & Laboratories</h5>

                    <!-- Table with stripped rows -->
                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th class="text-center">Classroom ID</th>
                                <th>Classroom Name</th>
                                <th class="text-center">Created</th>
                                <th class="text-center">Modified</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item.ClassroomID</td>
                                    <td><strong>@item.ClassroomName</strong></td>
                                    <td class="text-center">@item.Created.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">@item.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <a asp-controller="Classroom" asp-action="ClassroomAddEdit" asp-route-id="@item.ClassroomID" class="text-warning me-3" title="Edit Classroom">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a asp-controller="Classroom" asp-action="Delete" asp-route-id="@item.ClassroomID" class="text-danger" title="Delete Classroom"
                                           onclick="return confirm('Are you sure you want to delete this classroom?')">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <!-- End Table with stripped rows -->

                </div>
            </div>

        </div>
    </div>
</section>
