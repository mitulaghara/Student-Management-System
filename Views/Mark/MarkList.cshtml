@model List<StudentManagementSystem.Models.Mark>

<div class="pagetitle">
    <h1>Examinations &amp; Grades</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-award"></i> Student Marks</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="action-toolbar mb-3">
    <span class="fw-semibold text-muted fs-6">Marks Registry</span>
    <div class="action-btns">
        <a asp-controller="Mark" asp-action="MarkAddEdit" class="btn btn-primary">
            <i class="bi bi-plus-square-fill me-1"></i> Add Exam Marks
        </a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Student Academic Marks &amp; Grade Registry</h5>

                    <!-- Responsive Table Wrapper -->
                    <div class="table-responsive">
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="min-width: 60px;">#</th>
                                    <th style="min-width: 140px;">Student Name</th>
                                    <th style="min-width: 130px;">Course / Subject</th>
                                    <th style="min-width: 100px;">Exam Type</th>
                                    <th class="text-center" style="min-width: 110px;">Marks Obtained</th>
                                    <th class="text-center" style="min-width: 100px;">Total Marks</th>
                                    <th class="text-center" style="min-width: 75px;">Grade</th>
                                    <th style="min-width: 110px;">Remarks</th>
                                    <th class="text-center" style="min-width: 90px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@item.MarkID</td>
                                        <td><strong>@item.StudentName</strong></td>
                                        <td><i class="bi bi-book text-primary me-1"></i>@item.CourseName</td>
                                        <td><span class="badge bg-light text-dark border">@item.ExamType</span></td>
                                        <td class="text-center fw-bold text-primary">@item.MarksObtained</td>
                                        <td class="text-center text-muted">@item.TotalMarks</td>
                                        <td class="text-center">
                                            @if (item.Grade == "A+" || item.Grade == "A")
                                            {
                                                <span class="badge bg-success">@item.Grade</span>
                                            }
                                            else if (item.Grade == "B+" || item.Grade == "B")
                                            {
                                                <span class="badge bg-primary">@item.Grade</span>
                                            }
                                            else if (item.Grade == "C" || item.Grade == "D")
                                            {
                                                <span class="badge bg-warning text-dark">@item.Grade</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">@item.Grade</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrEmpty(item.Remarks) ? "--" : item.Remarks)</td>
                                        <td class="text-center" style="white-space: nowrap;">
                                            <a asp-controller="Mark" asp-action="MarkAddEdit" asp-route-id="@item.MarkID"
                                               class="text-warning me-2" title="Edit Mark">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </a>
                                            <a asp-controller="Mark" asp-action="Delete" asp-route-id="@item.MarkID"
                                               class="text-danger" title="Delete Mark"
                                               onclick="return confirm('Are you sure you want to delete this mark record?')">
                                                <i class="bi bi-trash fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- End Responsive Table Wrapper -->

                </div>
            </div>
        </div>
    </div>
</section>
