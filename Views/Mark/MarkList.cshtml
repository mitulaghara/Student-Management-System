@model List<StudentManagementSystem.Models.Mark>

<div class="pagetitle">
    <h1>Examinations & Grades</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-award"></i> Student Marks</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.IsMock == true)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <strong>Running on Mock Data!</strong> Could not connect to MongoDB.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="m-2">
    <div class="bg-primary-subtle rounded row pt-2 pb-2 align-items-center">
        <div class="col-7"></div>
        <div class="col-5 text-end pe-4">
            <a asp-controller="Mark" asp-action="MarkAddEdit" class="btn btn-primary">
                <i class="bi bi-plus-square-fill"></i> Add Exam Marks
            </a>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Student Academic Marks & Grade Registry</h5>

                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>Student Name</th>
                                <th>Course / Subject</th>
                                <th>Exam Type</th>
                                <th class="text-center">Marks Obtained</th>
                                <th class="text-center">Total Marks</th>
                                <th class="text-center">Grade</th>
                                <th>Remarks</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item.MarkID</td>
                                    <td><strong>@item.StudentName</strong></td>
                                    <td><i class="bi bi-book text-primary me-1"></i>@item.CourseName</td>
                                    <td><span class="badge bg-light text-dark border">@item.ExamType</span></td>
                                    <td class="text-center fw-bold text-primary">@item.MarksObtained</td>
                                    <td class="text-center text-muted">@item.TotalMarks</td>
                                    <td class="text-center">
                                        @if (item.Grade == "A+" || item.Grade == "A")
                                        {
                                            <span class="badge bg-success">@item.Grade</span>
                                        }
                                        else if (item.Grade == "B+" || item.Grade == "B")
                                        {
                                            <span class="badge bg-primary">@item.Grade</span>
                                        }
                                        else if (item.Grade == "C" || item.Grade == "D")
                                        {
                                            <span class="badge bg-warning text-dark">@item.Grade</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@item.Grade</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(item.Remarks) ? "--" : item.Remarks)</td>
                                    <td class="text-center">
                                        <a asp-controller="Mark" asp-action="MarkAddEdit" asp-route-id="@item.MarkID"
                                           class="text-warning me-3" title="Edit Mark">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a asp-controller="Mark" asp-action="Delete" asp-route-id="@item.MarkID"
                                           class="text-danger" title="Delete Mark"
                                           onclick="return confirm('Are you sure you want to delete this mark record?')">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</section>
