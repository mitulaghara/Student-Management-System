@model List<Staff>

<div class="pagetitle">
    <h1>Staff / Faculty</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-user-tie"></i> Staff List</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="action-toolbar mb-3">
    <span class="fw-semibold text-muted fs-6">Faculty &amp; Staff Directory</span>
    <div class="action-btns">
        <a asp-controller="Staff" asp-action="StaffAddEdit" class="btn btn-primary"><i class="bi bi-plus-square-fill me-1"></i> Add Staff Member</a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Staff / Faculty Directory</h5>

                    <!-- Responsive Table Wrapper -->
                    <div class="table-responsive">
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="min-width: 80px;">Staff ID</th>
                                    <th style="min-width: 140px;">Staff Name</th>
                                    <th style="min-width: 140px;">Department Name</th>
                                    <th style="min-width: 120px;">Mobile No</th>
                                    <th style="min-width: 160px;">Email Address</th>
                                    <th style="min-width: 120px;">Remarks</th>
                                    <th class="text-center" style="min-width: 90px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@item.StaffID</td>
                                        <td><strong>@item.StaffName</strong></td>
                                        <td>@item.DepartmentName</td>
                                        <td>@item.MobileNo</td>
                                        <td><a href="mailto:@item.EmailAddress">@item.EmailAddress</a></td>
                                        <td>@(string.IsNullOrEmpty(item.Remarks) ? "--" : item.Remarks)</td>
                                        <td class="text-center" style="white-space: nowrap;">
                                            <a asp-controller="Staff" asp-action="StaffAddEdit" asp-route-id="@item.StaffID" class="text-warning me-2" title="Edit Staff Details">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </a>
                                            <a asp-controller="Staff" asp-action="Delete" asp-route-id="@item.StaffID" class="text-danger" title="Delete Staff Member"
                                               onclick="return confirm('Are you sure you want to delete this staff member?')">
                                                <i class="bi bi-trash fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- End Responsive Table Wrapper -->

                </div>
            </div>
        </div>
    </div>
</section>
