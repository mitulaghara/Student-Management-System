@model List<StudentManagementSystem.Models.Notice>

<div class="pagetitle">
    <h1>Notice Board & Announcements</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-bullhorn"></i> Notice Board</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.IsMock == true)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <strong>Running on Mock Data!</strong> Could not connect to MongoDB.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="m-2">
    <div class="bg-primary-subtle rounded row pt-2 pb-2 align-items-center">
        <div class="col-7"></div>
        <div class="col-5 text-end pe-4">
            <a asp-controller="Notice" asp-action="NoticeAddEdit" class="btn btn-primary">
                <i class="bi bi-plus-square-fill"></i> Post New Notice
            </a>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Campus Announcements</h5>

                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Content Summary</th>
                                <th class="text-center">Published Date</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item.NoticeID</td>
                                    <td><strong>@item.Title</strong></td>
                                    <td>
                                        @if (item.Category == "Exam")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-award me-1"></i>Exam</span>
                                        }
                                        else if (item.Category == "Academic")
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-book me-1"></i>Academic</span>
                                        }
                                        else if (item.Category == "Holiday")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-calendar-event me-1"></i>Holiday</span>
                                        }
                                        else if (item.Category == "Sports")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-trophy me-1"></i>Sports</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info"><i class="bi bi-info-circle me-1"></i>General</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Content) && item.Content.Length > 60)
                                        {
                                            @(item.Content.Substring(0, 60) + "...")
                                        }
                                        else
                                        {
                                            @item.Content
                                        }
                                    </td>
                                    <td class="text-center">@item.PublishedDate.ToString("dd-MMM-yyyy")</td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Archived</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Notice" asp-action="NoticeAddEdit" asp-route-id="@item.NoticeID"
                                           class="text-warning me-3" title="Edit Notice">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a asp-controller="Notice" asp-action="Delete" asp-route-id="@item.NoticeID"
                                           class="text-danger" title="Delete Notice"
                                           onclick="return confirm('Are you sure you want to delete this notice?')">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</section>
