@model List<StudentManagementSystem.Models.Notice>

<div class="pagetitle">
    <h1>Notice Board &amp; Announcements</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-bullhorn"></i> Notice Board</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="action-toolbar mb-3">
    <span class="fw-semibold text-muted fs-6">Campus Notices</span>
    <div class="action-btns">
        <a asp-controller="Notice" asp-action="NoticeAddEdit" class="btn btn-primary">
            <i class="bi bi-plus-square-fill me-1"></i> Post New Notice
        </a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Campus Announcements</h5>

                    <!-- Responsive Table Wrapper -->
                    <div class="table-responsive">
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="min-width: 60px;">#</th>
                                    <th style="min-width: 160px;">Title</th>
                                    <th style="min-width: 100px;">Category</th>
                                    <th style="min-width: 180px;">Content Summary</th>
                                    <th class="text-center" style="min-width: 120px;">Published Date</th>
                                    <th class="text-center" style="min-width: 80px;">Status</th>
                                    <th class="text-center" style="min-width: 90px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@item.NoticeID</td>
                                        <td><strong>@item.Title</strong></td>
                                        <td>
                                            @if (item.Category == "Exam")
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-award me-1"></i>Exam</span>
                                            }
                                            else if (item.Category == "Academic")
                                            {
                                                <span class="badge bg-primary"><i class="bi bi-book me-1"></i>Academic</span>
                                            }
                                            else if (item.Category == "Holiday")
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-calendar-event me-1"></i>Holiday</span>
                                            }
                                            else if (item.Category == "Sports")
                                            {
                                                <span class="badge bg-success"><i class="bi bi-trophy me-1"></i>Sports</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info"><i class="bi bi-info-circle me-1"></i>General</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Content) && item.Content.Length > 60)
                                            {
                                                @(item.Content.Substring(0, 60) + "...")
                                            }
                                            else
                                            {
                                                @item.Content
                                            }
                                        </td>
                                        <td class="text-center" style="white-space: nowrap;">@item.PublishedDate.ToString("dd-MMM-yyyy")</td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Archived</span>
                                            }
                                        </td>
                                        <td class="text-center" style="white-space: nowrap;">
                                            <a asp-controller="Notice" asp-action="NoticeAddEdit" asp-route-id="@item.NoticeID"
                                               class="text-warning me-2" title="Edit Notice">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </a>
                                            <a asp-controller="Notice" asp-action="Delete" asp-route-id="@item.NoticeID"
                                               class="text-danger" title="Delete Notice"
                                               onclick="return confirm('Are you sure you want to delete this notice?')">
                                                <i class="bi bi-trash fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- End Responsive Table Wrapper -->

                </div>
            </div>
        </div>
    </div>
</section>
