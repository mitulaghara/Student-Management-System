@model List<StudentManagementSystem.Models.Timetable>

<div class="pagetitle">
    <h1>Timetable & Class Schedules</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-calendar-days"></i> Timetable</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="m-2">
    <div class="bg-primary-subtle rounded row pt-2 pb-2 align-items-center">
        <div class="col-7"></div>
        <div class="col-5 text-end pe-4">
            <a asp-controller="Timetable" asp-action="TimetableAddEdit" class="btn btn-primary">
                <i class="bi bi-plus-square-fill"></i> Add Class Schedule
            </a>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Weekly Class Routine & Timetable</h5>

                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>Day</th>
                                <th>Time</th>
                                <th>Subject</th>
                                <th>Department</th>
                                <th>Faculty</th>
                                <th>Classroom</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item.TimetableID</td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary fw-bold">@item.DayOfWeek</span>
                                    </td>
                                    <td><i class="bi bi-clock text-muted me-1"></i>@item.StartTime - @item.EndTime</td>
                                    <td><strong>@item.Subject</strong></td>
                                    <td>@item.DepartmentName</td>
                                    <td><i class="bi bi-person text-secondary me-1"></i>@item.StaffName</td>
                                    <td><span class="badge bg-light text-dark border">@item.ClassroomName</span></td>
                                    <td class="text-center">
                                        <a asp-controller="Timetable" asp-action="TimetableAddEdit" asp-route-id="@item.TimetableID"
                                           class="text-warning me-3" title="Edit Schedule">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a asp-controller="Timetable" asp-action="Delete" asp-route-id="@item.TimetableID"
                                           class="text-danger" title="Delete Schedule"
                                           onclick="return confirm('Are you sure you want to delete this class schedule?')">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</section>
