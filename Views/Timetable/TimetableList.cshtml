@model List<StudentManagementSystem.Models.Timetable>

<div class="pagetitle">
    <h1>Timetable &amp; Class Schedules</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-calendar-days"></i> Timetable</li>
        </ol>
    </nav>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="action-toolbar mb-3">
    <span class="fw-semibold text-muted fs-6">Weekly Schedule</span>
    <div class="action-btns">
        <a asp-controller="Timetable" asp-action="TimetableAddEdit" class="btn btn-primary">
            <i class="bi bi-plus-square-fill me-1"></i> Add Class Schedule
        </a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Weekly Class Routine &amp; Timetable</h5>

                    <div class="table-responsive">
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="min-width: 60px;">#</th>
                                    <th style="min-width: 100px;">Day</th>
                                    <th style="min-width: 130px;">Time</th>
                                    <th style="min-width: 130px;">Subject</th>
                                    <th style="min-width: 130px;">Department</th>
                                    <th style="min-width: 130px;">Faculty</th>
                                    <th style="min-width: 110px;">Classroom</th>
                                    <th class="text-center" style="min-width: 90px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@item.TimetableID</td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary fw-bold">@item.DayOfWeek</span>
                                        </td>
                                        <td style="white-space: nowrap;"><i class="bi bi-clock text-muted me-1"></i>@item.StartTime - @item.EndTime</td>
                                        <td><strong>@item.Subject</strong></td>
                                        <td>@item.DepartmentName</td>
                                        <td><i class="bi bi-person text-secondary me-1"></i>@item.StaffName</td>
                                        <td><span class="badge bg-light text-dark border">@item.ClassroomName</span></td>
                                        <td class="text-center" style="white-space: nowrap;">
                                            <a asp-controller="Timetable" asp-action="TimetableAddEdit" asp-route-id="@item.TimetableID"
                                               class="text-warning me-2" title="Edit Schedule">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </a>
                                            <a asp-controller="Timetable" asp-action="Delete" asp-route-id="@item.TimetableID"
                                               class="text-danger" title="Delete Schedule"
                                               onclick="return confirm('Are you sure you want to delete this class schedule?')">
                                                <i class="bi bi-trash fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
