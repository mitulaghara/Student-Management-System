@model List<Enrollment>

<div class="pagetitle">
    <h1>Student Advising & Enrollments</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-users"></i> Enrollment Directory</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (ViewBag.IsMock == true)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <strong>Running on Mock Data!</strong> Could not connect to your SQL Server database. Please set it up using the SQL script <code>StudentManagementSystem.sql</code>.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="m-2">
    <div class="bg-primary-subtle rounded row pt-2 pb-2 align-items-center">
        <div class="col-7"></div>
        <div class="col-5 text-end pe-4">
            <a asp-controller="Enrollment" asp-action="EnrollmentAddEdit" class="btn btn-primary"><i class="bi bi-plus-square-fill"></i> Assign Advisor / Mentor</a>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Student - Staff Mentorship Assignments</h5>

                    <!-- Table with stripped rows -->
                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th class="text-center">Enrollment ID</th>
                                <th>Student Name</th>
                                <th>Assigned Advisor (Staff)</th>
                                <th class="text-center">Status</th>
                                <th>Remarks</th>
                                <th class="text-center">Created</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item.EnrollmentID</td>
                                    <td><strong>@item.StudentName</strong></td>
                                    <td><i class="bi bi-person-workspace text-primary me-1"></i>@item.StaffName</td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(item.Remarks) ? "--" : item.Remarks)</td>
                                    <td class="text-center">@item.Created.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <a asp-controller="Enrollment" asp-action="EnrollmentAddEdit" asp-route-id="@item.EnrollmentID" class="text-warning me-3" title="Edit Assignment">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a asp-controller="Enrollment" asp-action="Delete" asp-route-id="@item.EnrollmentID" class="text-danger" title="Remove Assignment"
                                           onclick="return confirm('Are you sure you want to remove this advisor assignment?')">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <!-- End Table with stripped rows -->

                </div>
            </div>

        </div>
    </div>
</section>
