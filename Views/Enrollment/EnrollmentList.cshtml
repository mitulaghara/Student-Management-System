@model List<Enrollment>

<div class="pagetitle">
    <h1>Student Advising &amp; Enrollments</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="fa-solid fa-users"></i> Enrollment Directory</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="action-toolbar mb-3">
    <span class="fw-semibold text-muted fs-6">Mentorship Assignments</span>
    <div class="action-btns">
        <a asp-controller="Enrollment" asp-action="EnrollmentAddEdit" class="btn btn-primary"><i class="bi bi-plus-square-fill me-1"></i> Assign Advisor / Mentor</a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Student - Staff Mentorship Assignments</h5>

                    <!-- Responsive Table Wrapper -->
                    <div class="table-responsive">
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="min-width: 100px;">Enrollment ID</th>
                                    <th style="min-width: 140px;">Student Name</th>
                                    <th style="min-width: 150px;">Assigned Advisor (Staff)</th>
                                    <th class="text-center" style="min-width: 80px;">Status</th>
                                    <th style="min-width: 120px;">Remarks</th>
                                    <th class="text-center" style="min-width: 130px;">Created</th>
                                    <th class="text-center" style="min-width: 90px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@item.EnrollmentID</td>
                                        <td><strong>@item.StudentName</strong></td>
                                        <td><i class="bi bi-person-workspace text-primary me-1"></i>@item.StaffName</td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrEmpty(item.Remarks) ? "--" : item.Remarks)</td>
                                        <td class="text-center" style="white-space: nowrap;">@item.Created.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-center" style="white-space: nowrap;">
                                            <a asp-controller="Enrollment" asp-action="EnrollmentAddEdit" asp-route-id="@item.EnrollmentID" class="text-warning me-2" title="Edit Assignment">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </a>
                                            <a asp-controller="Enrollment" asp-action="Delete" asp-route-id="@item.EnrollmentID" class="text-danger" title="Remove Assignment"
                                               onclick="return confirm('Are you sure you want to remove this advisor assignment?')">
                                                <i class="bi bi-trash fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- End Responsive Table Wrapper -->

                </div>
            </div>
        </div>
    </div>
</section>
