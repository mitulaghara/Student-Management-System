@model StudentManagementSystem.Models.UserLoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Login - Student Management System</title>
    <!-- Favicons -->
    <link href="~/assets/img/favicon.png" rel="icon">
    <!-- Google Fonts -->
    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">
    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" asp-append-version="true">
    <!-- Template Main CSS File -->
    <link href="~/assets/css/style.css" rel="stylesheet" asp-append-version="true">
</head>
<body class="mu-login-page">
    <main>
        <div class="container">
            <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4 d-flex flex-column align-items-center justify-content-center">
                            <div class="d-flex flex-column align-items-center justify-content-center py-3 text-center">
                                <a href="#" class="logo d-flex align-items-center w-auto text-decoration-none mb-2">
                                    <img src="~/assets/img/logo.png" alt="SMS Logo" class="me-2 mu-login-logo-wrap" style="max-height: 36px;">
                                    <span class="text-white fw-bold fs-4">SMS Admin Portal</span>
                                </a>
                                <span class="mu-university-pill">Marwadi University</span>
                            </div><!-- End Logo -->

                            <div class="card mb-3 border-0 w-100 mu-login-card">
                                <div class="card-body p-3 p-sm-4">
                                    <div class="pt-2 pb-2 text-center">
                                        <h5 class="card-title text-center pb-0 fs-4 text-dark fw-bold">Login to Your Account</h5>
                                        <p class="text-center small text-muted">Enter your username & password to access dashboard</p>
                                    </div>

                                    <form class="row g-3 needs-validation" method="post" asp-controller="Auth" asp-action="Login">
                                        @Html.AntiForgeryToken()
                                        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold small"></div>

                                        <div class="col-12">
                                            <label asp-for="UserName" class="form-label fw-bold">Username</label>
                                            <div class="input-group has-validation">
                                                <span class="input-group-text"><i class="bi bi-person text-primary"></i></span>
                                                <input type="text" asp-for="UserName" class="form-control" placeholder="e.g. admin" required>
                                            </div>
                                            <span asp-validation-for="UserName" class="text-danger small"></span>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="Password" class="form-label fw-bold">Password</label>
                                            <div class="input-group has-validation">
                                                <span class="input-group-text"><i class="bi bi-lock text-primary"></i></span>
                                                <input type="password" asp-for="Password" class="form-control" placeholder="••••••••" required>
                                            </div>
                                            <span asp-validation-for="Password" class="text-danger small"></span>
                                        </div>

                                        <div class="col-12 mt-4">
                                            <button class="btn btn-primary w-100 py-2 fw-bold" type="submit"><i class="bi bi-box-arrow-in-right me-1"></i> Sign In</button>
                                        </div>
                                    </form>

                                    <div class="mt-3 text-center text-muted small bg-light p-2 rounded">
                                        <span>Default Credentials (Mock): <strong>admin</strong> / <strong>admin123</strong></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
