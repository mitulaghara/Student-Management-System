@model StudentManagementSystem.Models.ChangePasswordModel

<div class="pagetitle">
    <h1>Account Security</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> Home</a></li>
            <li class="breadcrumb-item active"><i class="bi bi-shield-lock"></i> Change Password</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <div>
                        <h5 class="card-title p-0 mb-1">Change Password</h5>
                        <p class="text-muted small mb-0">Ensure your account is using a long, secure password.</p>
                    </div>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-controller="Auth" asp-action="ChangePassword" method="post" class="row g-3">
                    <div class="col-12">
                        <label asp-for="CurrentPassword" class="form-label fw-bold">Current Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key text-primary"></i></span>
                            <input type="password" class="form-control" asp-for="CurrentPassword" placeholder="Enter current password" />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger fw-bold fs-7"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="NewPassword" class="form-label fw-bold">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock text-primary"></i></span>
                            <input type="password" class="form-control" asp-for="NewPassword" placeholder="Enter new password (min 6 characters)" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger fw-bold fs-7"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill text-primary"></i></span>
                            <input type="password" class="form-control" asp-for="ConfirmPassword" placeholder="Re-enter new password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger fw-bold fs-7"></span>
                    </div>

                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2-circle me-1"></i> Update Password</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4"><i class="bi bi-x-octagon-fill me-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
